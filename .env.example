# --- Langfuse (self-hosted) target ---------------------------------------
# Copy to .env and fill in. Point ONLY at a demo/sandbox project (see project_hint guardrail).
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# --- Model provider (only needed at demo time: `synth experiment`) --------
# The seed path makes NO model calls, so these are not required to `synth seed`.
ANTHROPIC_API_KEY=sk-ant-...

# If you run the experiment task model via Bedrock instead of the Anthropic API,
# configure standard AWS credentials instead and set TASK_PROVIDER=bedrock in demo.yaml.
