        "prompt_variables.policy_updates": [
          {
            "content": "For applications dated 2026-10-12 onwards, battery-electric vehicles with a purchase price of EUR 50,000 or less qualify for a EUR 6,000 point-of-sale purchase grant. The grant is deducted from the purchase price before the amount financed is assessed against the preapproved credit line. Other vehicle categories and purchases above EUR 50,000 do not qualify. Earlier applications receive no grant under this programme. This amendment updates the vehicle lending handbook's calculation of the amount financed; the credit-line approval threshold is unchanged.",
