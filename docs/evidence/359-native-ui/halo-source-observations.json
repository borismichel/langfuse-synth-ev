      "level": "DEFAULT",
      "statusMessage": "",
      "version": "",
      "environment": "production",
      "input": "[{\"role\":\"system\",\"content\":\"You assess vehicle-loan applications for a lender using the supplied policy documents.\\nThese documents define a fictional policy; do not use outside knowledge of grant programmes.\\nDetermine applicable purchase grants from the supplied policy evidence, calculate the amount financed, and then compare it with the applicant's preapproved credit line. Apply provisions only when the application date and vehicle meet their conditions.\\nReturn the purchase price, grant applied, financed principal, approved line, a one-sentence explanation, and a decision. The decision is approve when financed principal is at or below the approved line, and reject when it exceeds the line. The decision must agree with the amounts.\\n\"},{\"role\":\"user\",\"content\":\"Application:\\n{\\\"applicant_id\\\":\\\"anon_0029\\\",\\\"approved_line_eur\\\":38500,\\\"vehicle\\\":{\\\"type\\\":\\\"BEV\\\",\\\"list_price_eur\\\":40000},\\\"application_date\\\":\\\"2026-10-19\\\"}\\n\\nLending handbook:\\n{\\\"content\\\": \\\"For a vehicle purchase, the amount financed is the purchase price. Compare the amount financed with the applicant's preapproved credit line. Approve an amount at or below that line; otherwise reject. Record the purchase price, any purchase grant applied, the amount financed, and the credit line in the decision. Vehicle categories are BEV (battery electric), PHEV (plug-in hybrid), and ICE (internal combustion).\\\", \\\"document_id\\\": \\\"LENDING-1\\\", \\\"effective_date\\\": \\\"2026-04-15\\\", \\\"published_date\\\": \\\"2026-04-15\\\", \\\"title\\\": \\\"Vehicle lending handbook\\\"}\"}]",
      "output": "{\"decision\":\"reject\",\"list_price_eur\":40000,\"applied_grant_eur\":0,\"financed_principal_eur\":40000,\"approved_line_eur\":38500,\"reason\":\"Financed amount of EUR 40,000 exceeds the approved line of EUR 38,500.\"}",
      "metadata": {
